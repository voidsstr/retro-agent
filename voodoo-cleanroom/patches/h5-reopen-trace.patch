+      hwcTrace("setVideoMode: DirectDrawEnumerateExA", 0, 0);
       ddEnumEx( ddEnumCbEx, &enumInfo, DDENUM_ATTACHEDSECONDARYDEVICES );
       ddGuid = &(enumInfo.guid);
       GDBG_INFO(80, "GUID %d-%d-%d-%d-%d%d%d%d\n",
@@ -227,27 +272,43 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
   **  an 8-bit display, and fix up vidProcCfg in the minihwc.
   */
   /* KoolSmoky - what would happen if we run from 8bpp? */
+  hwcTrace("setVideoMode: desktop registry mode (reg=w<<16|h val=bpp)",
+           (devMode.dmPelsWidth << 16) | (devMode.dmPelsHeight & 0xffff), devMode.dmBitsPerPel);
   if ((devMode.dmPelsWidth == (FxU32) bInfo->vidInfo.xRes) &&
       (devMode.dmPelsHeight ==  (FxU32) bInfo->vidInfo.yRes)) {
       GDBG_INFO(80, "DDraw communication hack: setting to 8bpp!\n");
+      /* [retro3dfx REOPEN-TRACE] the Glide mode IS the desktop's size: the
+       * DirectDraw mode set below goes through an 8 bpp desktop (two extra
+       * depth changes per open/close, a palettized desktop in between) */
+      hwcTrace("setVideoMode: Glide res == desktop res - DDraw 8 bpp detour (reg=w<<16|h)",
+               (bInfo->vidInfo.xRes << 16) | (bInfo->vidInfo.yRes & 0xffff), 8);
       bpp = 8;
   }
   
   if (bInfo->lpDD == NULL) {
     /* only create directdraw object once */
+    hwcTrace("setVideoMode: DirectDrawCreate", 0, 0);
     if ( DirectDrawCreate( ddGuid, &(bInfo->lpDD1), NULL ) != DD_OK) {
       GDBG_INFO(80, "DDraw Obj Create Failed!\n");
     }
     else GDBG_INFO(80, "DDraw Obj created!\n");
+    hwcTrace("setVideoMode: DirectDrawCreate returned; QueryInterface IDirectDraw2 (reg=lpDD1)",
+             (FxU32) bInfo->lpDD1, 0);
     if ( IDirectDraw_QueryInterface( bInfo->lpDD1, &IID_IDirectDraw2, 
                                      (LPVOID*)&(bInfo->lpDD) ) != DD_OK ) {
       IDirectDraw_Release( bInfo->lpDD1 );
       bInfo->lpDD1 = NULL;
       bInfo->lpDD  = NULL;
       GDBG_INFO(80, "DDraw Obj Create Failed!\n");
+      hwcTrace("setVideoMode: IDirectDraw2 QueryInterface FAILED - open fails", 0, 0);
       return FXFALSE;
     }
     else GDBG_INFO(80, "DDraw2 Obj created!\n");
+  } else {
+    /* [retro3dfx REOPEN-TRACE] a close whose release was not confirmed keeps
+     * its DirectDraw object (hwcReleaseDisplay returns before hwcResetVideo) */
+    hwcTrace("setVideoMode: DirectDraw object KEPT from an earlier open (reg=lpDD)",
+             (FxU32) bInfo->lpDD, 0);
   }
 
   /* Set Exclusive Mode, change resolution,  */
@@ -262,7 +323,10 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
     
     GDBG_INFO(80, "Calling IDD2_SetCoop: 0x%x, 0x%x, 0x%x\n", bInfo->lpDD, bInfo->vidInfo.hWnd, dwFlags );
     
+    winTraceWnd("setVideoMode: SetCooperativeLevel EXCLUSIVE|FULLSCREEN (reg=hwnd val=window "
+                "flags as at enter)", (HWND)bInfo->vidInfo.hWnd);
     hResult = IDirectDraw2_SetCooperativeLevel(bInfo->lpDD, (HWND)bInfo->vidInfo.hWnd, dwFlags);
+    hwcTrace("setVideoMode: SetCooperativeLevel returned (val=HRESULT)", dwFlags, (FxU32) hResult);
     
     if(hResult != DD_OK)
     {
@@ -287,8 +351,10 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
       if (hResult & DDERR_OUTOFMEMORY)
         GDBG_INFO_MORE(80, "DDERR_OUTOFMEMORY\n" );
       
-      if (!_set_exclusive_relaxed)
+      if (!_set_exclusive_relaxed) {
+        hwcTrace("setVideoMode: no exclusive mode - open fails (val=HRESULT)", 0, (FxU32) hResult);
         return FXFALSE;
+      }
     }
   }
   GDBG_INFO(80, "FSEM Set\n" );
@@ -310,8 +376,11 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
   emcData.modeOK = FXFALSE;
   emcData.bpp = bpp;
   
+  hwcTrace("setVideoMode: EnumDisplayModes", 0, 0);
   hResult = IDirectDraw2_EnumDisplayModes(bInfo->lpDD, 0, &ddsd, 
                                           (LPVOID) &emcData, enumModesCallback);
+  hwcTrace("setVideoMode: EnumDisplayModes returned (reg=modeOK val=HRESULT)",
+           emcData.modeOK, (FxU32) hResult);
   
   if (hResult != DD_OK) {
     GDBG_INFO(80, "Warning:  EnumDisplayModes failed due to: \n");
@@ -323,12 +392,19 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
   if (emcData.modeOK) {
     GDBG_INFO(80, "Found mode %dx%d.  Attempting at %dHz\n", bInfo->vidInfo.xRes,
               bInfo->vidInfo.yRes, refresh);
+    hwcTrace("setVideoMode: SetDisplayMode (reg=w<<16|h val=bpp<<16|refresh)",
+             (bInfo->vidInfo.xRes << 16) | (bInfo->vidInfo.yRes & 0xffff),
+             (bpp << 16) | (refresh & 0xffff));
     hResult = IDirectDraw2_SetDisplayMode( bInfo->lpDD, bInfo->vidInfo.xRes, bInfo->vidInfo.yRes, bpp, refresh, 0);
+    hwcTrace("setVideoMode: SetDisplayMode returned (val=HRESULT)", 0, (FxU32) hResult);
     if (hResult != DD_OK) {
       GDBG_INFO(80, "Couldn't set display mode\n" );
       msgModeSetFailure(hResult);
       GDBG_INFO(80, "Retrying at default resolution\n");
+      hwcTrace("setVideoMode: SetDisplayMode retry at the default refresh (reg=w<<16|h val=bpp<<16)",
+               (bInfo->vidInfo.xRes << 16) | (bInfo->vidInfo.yRes & 0xffff), bpp << 16);
       hResult = IDirectDraw2_SetDisplayMode( bInfo->lpDD, bInfo->vidInfo.xRes, bInfo->vidInfo.yRes, bpp, 0, 0 );
+      hwcTrace("setVideoMode: SetDisplayMode retry returned (val=HRESULT)", 0, (FxU32) hResult);
       
       if (hResult != DD_OK) {
         GDBG_INFO(80, "Setting video mode %dx%d@default refresh failed!\n",
@@ -337,6 +413,7 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
         
         if (!_set_vidmode_relaxed) {
           GDBG_INFO(80, "Returning FXFALSE\n");
+          hwcTrace("setVideoMode: no display mode - open fails (val=HRESULT)", 0, (FxU32) hResult);
           return FXFALSE;
         } else {
           GDBG_INFO(80, "Continuing operation due to relaxation condition\n");
@@ -349,7 +426,11 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
     GDBG_INFO(80, "Did not find mode %dx%d@any refresh\n", bInfo->vidInfo.xRes, bInfo->vidInfo.yRes);
     GDBG_INFO(80, "Setting video mode %dx%d@default refresh\n", bInfo->vidInfo.xRes, bInfo->vidInfo.yRes);
 
+    hwcTrace("setVideoMode: mode not listed - SetDisplayMode at the default refresh "
+             "(reg=w<<16|h val=bpp<<16)",
+             (bInfo->vidInfo.xRes << 16) | (bInfo->vidInfo.yRes & 0xffff), bpp << 16);
     hResult = IDirectDraw2_SetDisplayMode( bInfo->lpDD, bInfo->vidInfo.xRes, bInfo->vidInfo.yRes, bpp, 0, 0 );
+    hwcTrace("setVideoMode: SetDisplayMode returned (val=HRESULT)", 0, (FxU32) hResult);
     
     if (hResult != DD_OK) {
       GDBG_INFO(80, "Failed!\n",
@@ -357,6 +438,7 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
       msgModeSetFailure(hResult);
       if (!_set_vidmode_relaxed) {
         GDBG_INFO(80, "Returning FXFALSE\n");
+        hwcTrace("setVideoMode: no display mode - open fails (val=HRESULT)", 0, (FxU32) hResult);
         return FXFALSE;
       } else {
         GDBG_INFO(80, "Continuing operation due to relaxation condition\n");
@@ -364,6 +446,7 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
     }
   }
   
+  winTraceWnd("setVideoMode: done (reg=hwnd val=window flags)", (HWND)bInfo->vidInfo.hWnd);
   return FXTRUE;
   
 } /* setVideoMode */

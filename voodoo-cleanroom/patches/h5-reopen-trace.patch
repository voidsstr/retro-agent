From 53e3d9f569b1ef306d9631250691dbcc69d3ea54 Mon Sep 17 00:00:00 2001
From: voidsstr <perrymb@gmail.com>
Date: Mon, 28 Sep 2026 10:11:46 -0400
Subject: [PATCH] h5: REOPEN-TRACE - split setVideoMode's DirectDraw calls, say
 which close ran, name the messages that lose the context

Unreal Gold on .124 (V5 6000) hung in its SECOND grSstWinOpen, made from inside
UE1's WM_KILLFOCUS handler, with the display still at the desktop mode. AA-TRACE
named the whole DirectDraw mode set as one step; this splits it (opt-in,
FX_GLIDE_TRACE, file writes only - off, nothing new runs but hwcTraceOn()):

- win_mode.c: a line BEFORE DirectDrawEnumerateExA, DirectDrawCreate,
  SetCooperativeLevel, EnumDisplayModes and each SetDisplayMode, its HRESULT
  after, the 8 bpp detour (Glide res == desktop res), a DirectDraw object kept
  from an earlier open, every failure return, the window's standing
  (foreground / iconic / visible / focus, no message sent to it) at enter and at
  the cooperative-level call; resetVideo's RestoreDisplayMode / NORMAL /
  Release.
- gsst.c: grSstWinClose's entry state and WHICH branch it took (a lost context
  skips idle, SLI/AA teardown and HWCRLSEXCLUSIVE) - read only with the trace on
  and only from a gc that passed the whacked-pointer check; the unmap;
  grSstWinOpenExt's request and whether the board is still mapped.
- minihwc.c: the XP alt-tab hook installed / not installed / off, undone or LEFT
  in the chain at hwcResetVideo, and every message it sees that can mark the
  context lost, plus the focus pair.

No behaviour change. Tests: retro-agent tests/python/test_h5_reopen_trace.py
(all fail on e767d89). Built: glide3x_h5.dll, glide3x_h5_x86.dll.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 glide3x/h5/glide3/src/gsst.c  | 26 ++++++++++
 glide3x/h5/minihwc/minihwc.c  | 29 +++++++++++
 glide3x/h5/minihwc/win_mode.c | 92 ++++++++++++++++++++++++++++++++++-
 3 files changed, 146 insertions(+), 1 deletion(-)

diff --git a/glide3x/h5/glide3/src/gsst.c b/glide3x/h5/glide3/src/gsst.c
index 1bf4e4a..bb55e10 100644
--- a/glide3x/h5/glide3/src/gsst.c
+++ b/glide3x/h5/glide3/src/gsst.c
@@ -1587,6 +1587,16 @@ GR_EXT_ENTRY(grSstWinOpenExt, GrContext_t, ( FxU32                   hWnd,
      * (_grTraceSync); a failed open leaves it for grSstWinClose/the next open */
     trSyncInOpen = 1;
 
+    /* [retro3dfx REOPEN-TRACE] the request as the application made it, and
+     * whether the board is still mapped from an earlier open of this process
+     * (a close unmaps it: the open re-maps below) */
+    hwcTrace("winopen: enter (reg=resolution<<16|refresh val=nColBuffers<<8|nAuxBuffers)",
+             ((FxU32) resolution << 16) | ((FxU32) refresh & 0xffff),
+             ((FxU32) nColBuffers << 8) | ((FxU32) nAuxBuffers & 0xff));
+    if (gc && hwcTraceOn())
+      hwcTrace("winopen: board state (reg=gc->open val=isMapped)", gc->open,
+               gc->bInfo ? gc->bInfo->isMapped : 0xffffffffUL);
+
     /*
     ** check if the environment variable for triple buffering is on
     */
@@ -3249,15 +3259,28 @@ GR_ENTRY(grSstWinClose, FxBool, (GrContext_t context))
   }
 #endif
 
+  /* [retro3dfx REOPEN-TRACE] a close made after the window lost activation
+   * (the XP alt-tab hook marks the context lost on WM_ACTIVATEAPP(FALSE), a
+   * minimize, a hide, a WM_DISPLAYCHANGE) takes the lost-context branch below:
+   * no idle, no SLI/AA teardown, no HWCRLSEXCLUSIVE - DirectDraw's mode restore
+   * alone. Unreal Gold's re-open on .124 followed exactly such a close (UE1
+   * tears the render device down in WM_KILLFOCUS). Say which one ran - read
+   * only with the trace on, and only from a gc that passed the check below. */
+
   /* Make sure that the user specified gc is not whacked */
   if ((gc != NULL) &&
       (gc >= _GlideRoot.GCs) &&
       (gc <= _GlideRoot.GCs + MAX_NUM_SST)) {
+    if (hwcTraceOn())
+      hwcTrace("close: enter (reg=open val=*lostContext, ffffffff = no pointer)",
+               gc->open, (gc->lostContext ? *gc->lostContext : 0xffffffffUL));
     if (gc->open) {
 #if GLIDE_CHECK_CONTEXT
       if (gc->lostContext && !*gc->lostContext)
 #endif
       {
+        hwcTrace("close: context live - orderly close (flush, SLI/AA off, idle, "
+                 "hwcRestoreVideo)", 0, 0);
         grFlush();
 
 #if GLIDE_INIT_HAL
@@ -3312,6 +3335,8 @@ GR_ENTRY(grSstWinClose, FxBool, (GrContext_t context))
       }
 #if (GLIDE_OS & GLIDE_OS_WIN32)
       else {
+        hwcTrace("close: context LOST - hwcResetVideo only (no idle, no SLI/AA teardown, "
+                 "no HWCRLSEXCLUSIVE)", 0, 0);
         hwcResetVideo(gc->bInfo);
       }
 #endif
@@ -3346,6 +3371,7 @@ GR_ENTRY(grSstWinClose, FxBool, (GrContext_t context))
     ** to unmap the selected board
     */
     /*if ( hwcIsOSWin9x() ) {*/
+      hwcTrace("close: hwcUnmapMemory9x (the next open re-maps the board)", 0, 0);
       hwcUnmapMemory9x( gc->bInfo );
     /*} else {
       hwcUnmapMemory();
diff --git a/glide3x/h5/minihwc/minihwc.c b/glide3x/h5/minihwc/minihwc.c
index e95e589..a6e7058 100644
--- a/glide3x/h5/minihwc/minihwc.c
+++ b/glide3x/h5/minihwc/minihwc.c
@@ -4722,7 +4722,17 @@ hwcInitVideo(hwcBoardInfo *bInfo, FxBool tiled, FxVideoTimingInfo *vidTiming,
         if (curproc && curproc != (WNDPROC)_XPAltTabProc) {
           GDBG_INFO(80, FN_NAME ":  Setting up alt-tab fix hack.\n");
           wpWinProc = (WNDPROC)SetWindowLong((HWND)bInfo->vidInfo.hWnd, GWL_WNDPROC, (LONG)_XPAltTabProc);
+          /* [retro3dfx REOPEN-TRACE] from here WM_ACTIVATEAPP(FALSE),
+           * WM_DISPLAYCHANGE, a minimize, a hide mark the context LOST - and a
+           * lost context's grSstWinClose skips the whole orderly close */
+          hwcTrace("hwcInitVideo: XP alt-tab hook installed (reg=hwnd val=the proc it chains to)",
+                   bInfo->vidInfo.hWnd, (FxU32) wpWinProc);
+        } else {
+          hwcTrace("hwcInitVideo: XP alt-tab hook NOT installed (reg=hwnd val=current proc; "
+                   "already ours, or none)", bInfo->vidInfo.hWnd, (FxU32) curproc);
         }
+      } else {
+        hwcTrace("hwcInitVideo: XP alt-tab hook off (FX_GLIDE_ALT_TAB_FIX=0)", 0, 0);
       }
     }
 #endif
@@ -6349,8 +6359,15 @@ hwcResetVideo(hwcBoardInfo *bInfo) {
 
     if (curproc == (WNDPROC)_XPAltTabProc) {
       GDBG_INFO(80, FN_NAME ":  Undoing alt-tab fix hack.\n");
+      hwcTrace("hwcResetVideo: XP alt-tab hook undone (reg=hwnd val=proc restored)",
+               bInfo->vidInfo.hWnd, (FxU32) wpWinProc);
       SetWindowLong((HWND)bInfo->vidInfo.hWnd, GWL_WNDPROC, (LONG)wpWinProc);
       wpWinProc = 0;
+    } else if (wpWinProc) {
+      /* [retro3dfx REOPEN-TRACE] someone subclassed the window on top of our
+       * hook: it stays in the chain (and wpWinProc with it) */
+      hwcTrace("hwcResetVideo: XP alt-tab hook NOT on top - LEFT in the chain (reg=hwnd "
+               "val=current proc)", bInfo->vidInfo.hWnd, (FxU32) curproc);
     }
   }
 #endif
@@ -9613,6 +9630,18 @@ static LRESULT CALLBACK _XPAltTabProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARA
 {
 #define FN_NAME "_XPAltTabProc"
   
+  /* [retro3dfx REOPEN-TRACE] the messages that mark the context lost, and the
+   * focus pair around them (a UE1 WinDrv viewport tears its render device down
+   * in WM_KILLFOCUS). File writes only, and only with FX_GLIDE_TRACE. */
+  if (hwcTraceOn()) {
+    switch (uMsg) {
+    case WM_ACTIVATEAPP: case WM_DISPLAYCHANGE: case WM_SIZE: case WM_SHOWWINDOW:
+    case WM_STYLECHANGED: case WM_KILLFOCUS: case WM_SETFOCUS: case WM_ACTIVATE:
+      hwcTrace("alt-tab hook: message (reg=msg val=wParam)", uMsg, (FxU32) wParam);
+      break;
+    }
+  }
+
   if (uMsg == WM_ACTIVATEAPP)
     {
       if (wParam == FALSE)
diff --git a/glide3x/h5/minihwc/win_mode.c b/glide3x/h5/minihwc/win_mode.c
index 76e9b32..f30f9bb 100644
--- a/glide3x/h5/minihwc/win_mode.c
+++ b/glide3x/h5/minihwc/win_mode.c
@@ -50,6 +50,47 @@ static int _set_exclusive_relaxed;
 static int _set_vidmode_relaxed;
 static FxBool _set_multirendering;
 
+/* [retro3dfx REOPEN-TRACE] Unreal Gold on .124 (2026-09-28) hung in its SECOND
+ * grSstWinOpen - made from inside UE1's WM_KILLFOCUS handler (WinDrv
+ * EndFullscreen -> TryRenderDevice(WindowedRenderDevice)) - with the display
+ * still at the desktop mode, i.e. before this file's DirectDraw mode set took
+ * effect. AA-TRACE named the whole mode set as ONE step ("hwcInitVideo:
+ * setVideoMode"); these lines split it into the DirectDraw calls that can
+ * block, each written BEFORE the call, plus the window's standing (a
+ * fullscreen open made while the window is not the foreground window is the
+ * case to see). File writes only (FX_GLIDE_TRACE, process environment); off,
+ * nothing here runs but hwcTraceOn(). */
+#define WIN_WND_FG        0x01u   /* GetForegroundWindow() == hwnd */
+#define WIN_WND_ICONIC    0x02u
+#define WIN_WND_VISIBLE   0x04u
+#define WIN_WND_FG_OURS   0x08u   /* the foreground window belongs to this thread */
+#define WIN_WND_VALID     0x10u   /* IsWindow(hwnd) */
+#define WIN_WND_FOCUS     0x20u   /* GetFocus() == hwnd (this thread's focus) */
+
+static FxU32
+winWndFlags(HWND hwnd)
+{
+  HWND fg = GetForegroundWindow();
+  FxU32 f = 0;
+
+  if (IsWindow(hwnd))                                  f |= WIN_WND_VALID;
+  if (fg && fg == hwnd)                                f |= WIN_WND_FG;
+  if (hwnd && IsIconic(hwnd))                          f |= WIN_WND_ICONIC;
+  if (hwnd && IsWindowVisible(hwnd))                   f |= WIN_WND_VISIBLE;
+  if (fg && GetWindowThreadProcessId(fg, NULL) == GetCurrentThreadId())
+                                                       f |= WIN_WND_FG_OURS;
+  if (hwnd && GetFocus() == hwnd)                      f |= WIN_WND_FOCUS;
+  return f;
+}
+
+static void
+winTraceWnd(const char *step, HWND hwnd)
+{
+  if (!hwcTraceOn())
+    return;
+  hwcTrace(step, (FxU32) hwnd, winWndFlags(hwnd));
+}
+
 typedef struct _enumInfoStruct {
   GUID guid;
   HMONITOR hmon;
@@ -177,6 +218,9 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
   if ((HWND)bInfo->vidInfo.hWnd == NULL)
     bInfo->vidInfo.hWnd = (FxU32) GetActiveWindow();
 
+  winTraceWnd("setVideoMode: enter (reg=hwnd val=fg|iconic<<1|visible<<2|fgThreadOurs<<3"
+              "|valid<<4|focus<<5)", (HWND)bInfo->vidInfo.hWnd);
+
   ddGuid = NULL;
   ddraw = GetModuleHandle( "ddraw.dll" );
   if ( ddraw != NULL ) {
@@ -186,6 +230,7 @@ setVideoMode( hwcBoardInfo *bInfo, int refresh )
       ZeroMemory(&enumInfo, sizeof(enumInfo));
       ZeroMemory(&(enumInfo.guid), sizeof(GUID));

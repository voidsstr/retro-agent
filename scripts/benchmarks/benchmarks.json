{
  "_comment": "Data-driven benchmark manifest for the retro GPU shootout. Paths are per-machine; edit them on the first real run and they stick. The runner substitutes {width} {height} {colordepth} {depthbits} {fsaa} {tag} {demo} into config templates and launch lines.",
  "share": {
    "unc": "\\\\192.168.1.122\\files",
    "drive": "Z:",
    "bench_subdir": "Utility\\Retro Automation\\Benchmarks",
    "_creds": "SMB user/pass come from env RETRO_SMB_USER / RETRO_SMB_PASS (do not hardcode secrets here)."
  },
  "cards": {
    "voodoo5-5500": {
      "match": [
        "voodoo5 5500",
        "voodoo 5 5500",
        "voodoo5",
        "vsa-100",
        "vsa100",
        "3dfx"
      ],
      "color_depths": [
        16
      ],
      "fsaa_levels": [
        "off",
        "2x"
      ],
      "note": "2 x VSA-100, 64MB, 16-bit + 22-bit postfilter, RGSS FSAA, no HW T&L/shaders. 4x FSAA usually too slow above 640x480."
    },
    "voodoo5-6000": {
      "match": [
        "voodoo5 6000",
        "voodoo 5 6000",
        "voodoo 6000",
        "strange god"
      ],
      "color_depths": [
        16
      ],
      "fsaa_levels": [
        "off",
        "2x",
        "4x"
      ],
      "note": "4 x VSA-100, 128MB, external power, RGSS FSAA, no HW T&L/shaders. 4x FSAA is the whole point - keep it in."
    },
    "geforce4-ti4600": {
      "match": [
        "geforce4 ti 4600",
        "geforce4 ti4600",
        "ti 4600",
        "ti4600",
        "nv25",
        "geforce4 ti"
      ],
      "color_depths": [
        16,
        32
      ],
      "fsaa_levels": [
        "off",
        "2x",
        "4x"
      ],
      "note": "NV25, 128MB, true 32-bit, MSAA (edges only), HW T&L + DX8.1 shaders. Runs the 3DMark shader/Nature tests the Voodoos cannot."
    },
    "radeon-9800xt": {
      "match": [
        "radeon 9800 xt",
        "radeon 9800xt",
        "9800 xt",
        "9800xt",
        "r360",
        "radeon 9800"
      ],
      "color_depths": [
        16,
        32
      ],
      "fsaa_levels": [
        "off",
        "2x",
        "4x"
      ],
      "note": "R360, 256MB, true 32-bit, MSAA + anisotropic, DX9 / SM2.0 - the newest card on the bench and the only one that runs 3DMark2001's shader tests at full detail. Unreal-engine titles use D3D (the runner default), never Glide. R360 also does 6x MSAA; it is left out so the FSAA column stays comparable with the Voodoo5 and GeForce4 rows."
    }
  },
  "default_resolutions": [
    "640x480",
    "800x600",
    "1024x768",
    "1600x1200"
  ],
  "titles": {
    "quake3": {
      "name": "Quake III Arena",
      "api": "opengl",
      "proc_name": "quake3.exe",
      "workdir": "{root}",
      "exists_check": "{root}\\quake3.exe",
      "stage_from_share": "Q3",
      "demo": "four",
      "config": {
        "target": "{root}\\baseq3\\bench.cfg",
        "template": "quake3_bench.cfg"
      },
      "result_file": "{root}\\baseq3\\bench_{tag}.log",
      "launch": "{root}\\quake3.exe +set fs_game baseq3 +set logfile 2 +exec bench.cfg",
      "parser": "quake3",
      "max_run_s": 240,
      "auto_quits": true,
      "roots": [
        "C:\\Quake III Arena\\Quake3",
        "C:\\Games\\Quake3-TeamArena",
        "C:\\Games\\Quake3",
        "C:\\Games\\Quake III Arena\\Quake3"
      ]
    },
    "ut": {
      "name": "Unreal Tournament",
      "api": "glide|d3d",
      "proc_name": "UnrealTournament.exe",
      "workdir": "{root}\\System",
      "exists_check": "{root}\\System\\UnrealTournament.exe",
      "demo": "DM-Morpheus",
      "launch": "{root}\\System\\UnrealTournament.exe DM-Morpheus.unr?quickstart=true -benchmark -seconds=30 -ini=bench.ini -userini=benchuser.ini -nosound",
      "config": {
        "target": "{root}\\System\\bench.ini",
        "template": "ut_bench.ini"
      },
      "result_file": "{root}\\System\\Benchmark\\benchmark.log",
      "parser": "unreal_log",
      "max_run_s": 120,
      "auto_quits": true,
      "roots": [
        "C:\\UnrealTournament",
        "C:\\UT",
        "C:\\Games\\UnrealTournament",
        "C:\\Games\\UnrealTournament436"
      ]
    },
    "deusex": {
      "name": "Deus Ex",
      "api": "glide|d3d",
      "proc_name": "DeusEx.exe",
      "workdir": "{root}\\System",
      "exists_check": "{root}\\System\\DeusEx.exe",
      "demo": "00_Training",
      "launch": "{root}\\System\\DeusEx.exe 00_Training.dx?quickstart=true -benchmark -seconds=45 -ini=bench.ini -nosound",
      "config": {
        "target": "{root}\\System\\bench.ini",
        "template": "ut_bench.ini"
      },
      "result_file": "{root}\\System\\Benchmark\\benchmark.log",
      "parser": "unreal_log",
      "max_run_s": 120,
      "auto_quits": true,
      "note": "Unreal engine - same -benchmark timedemo path as UT. No recorded flyby, so a fixed-time run on a scripted map segment; FRAPS-cross-checkable.",
      "roots": [
        "C:\\DeusEx",
        "C:\\Games\\DeusEx"
      ]
    },
    "serioussam": {
      "name": "Serious Sam - The First Encounter",
      "api": "opengl|d3d",
      "proc_name": "SeriousSam.exe",
      "workdir": "{root}",
      "exists_check": "{root}\\Bin\\SeriousSam.exe",
      "demo": "Default.dem",
      "launch": "{root}\\Bin\\SeriousSam.exe +game SeriousSam +exec bench.ini",
      "config": {
        "target": "{root}\\Scripts\\bench.ini",
        "template": "serioussam_bench.ini"
      },
      "result_file": "{root}\\bench_result.txt",
      "parser": "serioussam",
      "max_run_s": 180,
      "auto_quits": true,
      "note": "Uses the engine's built-in demo/benchmark script; dem_bProfile + demo playback writes avg/min/max to the log.",
      "roots": [
        "C:\\SeriousSam",
        "C:\\Games\\SeriousSamFirstEncounter"
      ]
    },
    "giants": {
      "name": "Giants - Citizen Kabuto",
      "api": "d3d",
      "proc_name": "Giants.exe",
      "workdir": "{root}",
      "exists_check": "{root}\\Giants.exe",
      "launch": "{root}\\Giants.exe",
      "fraps": true,
      "parser": "fraps",
      "result_file": "C:\\FRAPS\\Benchmarks\\Giants_{tag}_fps.csv",
      "max_run_s": 90,
      "auto_quits": false,
      "note": "No built-in timedemo. SEMI-AUTOMATED: runner launches FRAPS (benchmark auto-start + fixed frametime log) then the game; a fixed-time attract/first-scene run is captured. Requires a saved game or attract loop; flagged in the summary as FRAPS-assisted.",
      "roots": [
        "C:\\Giants",
        "C:\\Games\\Giants"
      ]
    },
    "3dmark99max": {
      "name": "3DMark99 MAX",
      "api": "d3d6",
      "proc_name": "3DMark99Max.exe",
      "workdir": "{root}",
      "exists_check": "{root}\\3DMark99Max.exe",
      "launch": "{root}\\3DMark99Max.exe -batch -resultfile={root}\\result_{tag}.txt",
      "result_file": "{root}\\result_{tag}.txt",
      "parser": "futuremark",
      "max_run_s": 420,
      "auto_quits": true,
      "note": "DX6. Batch args vary by build - confirm the exact -batch/-resultfile flags on first run.",
      "roots": [
        "C:\\3DMark99Max",
        "C:\\Games\\3DMark99Max"
      ]
    },
    "3dmark2000": {
      "name": "3DMark2000",
      "api": "d3d7",
      "proc_name": "3DMark2000.exe",
      "workdir": "{root}",
      "exists_check": "{root}\\3DMark2000.exe",
      "launch": "{root}\\3DMark2000.exe -batch -resultfile={root}\\result_{tag}.txt",
      "result_file": "{root}\\result_{tag}.txt",
      "parser": "futuremark",
      "max_run_s": 480,
      "auto_quits": true,
      "note": "DX7. HW T&L test: Voodoo5 has none -> software T&L; report the game-test breakdown, not just the composite.",
      "roots": [
        "C:\\3DMark2000",
        "C:\\Games\\3DMark2000"
      ]
    },
    "3dmark2001": {
      "name": "3DMark2001",
      "api": "d3d8",
      "proc_name": "3DMark2001.exe",
      "workdir": "{root}",
      "exists_check": "{root}\\3DMark2001.exe",
      "launch": "{root}\\3DMark2001.exe -batch -resultfile={root}\\result_{tag}.txt",
      "result_file": "{root}\\result_{tag}.txt",
      "parser": "futuremark",
      "max_run_s": 600,
      "auto_quits": true,
      "note": "DX8. Nature test needs pixel shaders -> N/A on Voodoo5 (reported as N/A, not zero). Vertex-shader tests fall back to software.",
      "roots": [
        "C:\\3DMark2001",
        "C:\\Games\\3DMark2001"
      ]
    }
  }
}

diff --git a/src/bot/func.c b/src/bot/func.c
index 1db697c..a7fe776 100644
--- a/src/bot/func.c
+++ b/src/bot/func.c
@@ -82,7 +82,11 @@ void Load_BotInfo()
 
 	//botlist value
 	botlist = gi.cvar ("botlist", "default", CVAR_SERVERINFO | CVAR_LATCH);
-	gamepath = gi.cvar ("game", "0", CVAR_NOSET);
+	/* NSC fleet: the bot data directory is its own cvar, NOT the gamedir. With
+	   "game" the server would have to run as gamedir 3zb2 and every client would
+	   switch to it; this keeps clients in vanilla baseq2. Paths are relative to
+	   the server's working directory. */
+	gamepath = gi.cvar ("zb_path", "3zb2", 0);
 
 	//load info
 	sprintf(Buff,"%s/3ZBConfig.cfg",gamepath->string);

/* 3dfxctl.rc - the icon, the comctl32 v6 manifest (XP visual styles) and the
 * version block. Built by windres (Makefile). */
#include <windows.h>

1 ICON "3dfxctl.ico"

/* CREATEPROCESS_MANIFEST_RESOURCE_ID (1), RT_MANIFEST (24) */
1 24 "3dfxctl.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,1,0
 PRODUCTVERSION 2,1,1,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "retro-agent"
      VALUE "FileDescription", "3dfx Control Panel"
      VALUE "FileVersion", "2.1.1"
      VALUE "InternalName", "3dfxctl"
      VALUE "OriginalFilename", "3dfxctl.exe"
      VALUE "ProductName", "3dfx Control Panel (vcr-kmd / h5 Glide / MesaFX)"
      VALUE "ProductVersion", "2.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

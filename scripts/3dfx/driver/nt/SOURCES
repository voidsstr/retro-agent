# NT/2000/XP DDK build file for the fxD3D display-driver host.
# Build inside the NT DDK "build" environment (or on a provisioned XP box via
# the agent - see ../README.md). Produces fxd3ddd.dll (the GDI display driver).
#
# This is the M3 host "chassis": it links the portable fxD3D core + glue and
# exposes the D3D DDI (DrawPrimitives2 -> fxd_dp2_execute).

TARGETNAME=fxd3ddd
TARGETTYPE=GDI_DRIVER
TARGETPATH=obj

# Pull in fxD3D core + glue from the sibling trees.
INCLUDES=..;..\..\d3dhal\include;..\..\d3dhal;..\..\glide-sdk\include

C_DEFINES=$(C_DEFINES) -DHAVE_DDK -DWIN32 -D_X86_

# Display drivers link the DDI + a def of exported Drv* entry points.
DLLDEF=dispdrv.def
DLLENTRY=DrvEnableDriver
TARGETLIBS=$(DDK_LIB_PATH)\win32k.lib

SOURCES= \
    enable.c            \
    chassis.c           \
    gbkdebug.c          \
    gbkernel.c          \
    gbk\gbk_packet.c    \
    gbk\gbk_layout.c    \
    gbk\gbk_state.c     \
    gbk\gbk_fifo.c      \
    gbk\gbk_surf.c      \
    crtshim.c           \
    ..\ddi_glue.c       \
    ..\..\d3dhal\d3dhal_state.c \
    ..\..\d3dhal\d3dhal_tex.c   \
    ..\..\d3dhal\d3dhal_prim.c  \
    ..\..\d3dhal\d3dhal_ddi.c   \
    ..\..\d3dhal\d3dhal_dp2real.c

# gbkdebug.c is the DrvEscape handler for the on-card BRING-UP LADDER (M4c-1):
# private escapes (FXDBG_PROBE/CLEAR/TRI/TEX/READBACK, see gbkdebug.h) the agent
# drives to validate the kernel Glide backend on real hardware before D3D does.
#
# The Glide backend on the driver side is the REAL kernel-mode MMIO transport
# (M4b-2): gbkernel.c drives the Voodoo3 directly through driver-mapped BAR0/
# BAR1, built on the host-verified pure-logic core gbk\gbk_{packet,layout,
# state,fifo}.c (see docs/3dfx-gbkernel-design.md). gbstub.c is kept in the
# tree as the NO-hardware link fallback but is OUT of the default build; swap
# it back in (for gbkernel.c + the four gbk\*.c) only for a no-hw smoke link
# (it now also stubs gbkernel_attach/detach + the gbkernel_dbg_* ladder that
# chassis.c/gbkdebug.c reference).
# For user-mode bring-up in 86Box the standalone glidebackend.c + glide3x.dll
# is used instead; see ../README.md "backend on the driver side".

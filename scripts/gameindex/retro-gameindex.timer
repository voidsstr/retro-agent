[Unit]
Description=Refresh the retro fleet game + server index every 5 minutes

[Timer]
# The requirement is "up to date within 5 minutes", so the interval is the
# guarantee, not a suggestion. AccuracySec=30s keeps systemd from coalescing
# this with unrelated timers and drifting past the window.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target

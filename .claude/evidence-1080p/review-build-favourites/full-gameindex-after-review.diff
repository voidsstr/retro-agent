+def test_the_captured_empty_file_is_what_the_fixtures_build():
+    """The servercache.dat downloaded from .123/.145/.195/.240 on 2026-09-28
+    (md5 1d9ecd77ad96baa12e160cf4ec596787: counts 0, size 692736, all zero)

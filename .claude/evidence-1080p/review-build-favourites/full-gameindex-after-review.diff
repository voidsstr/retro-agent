+def _age(con, addr, minutes, engine="q3"):
+    t = time.strftime("%Y-%m-%d %H:%M:%S",
+                      time.localtime(time.time() - minutes * 60))
+    con.execute("UPDATE servers SET last_seen=? WHERE engine=? AND addr=?",
+                (t, engine, addr))
+    con.commit()
+

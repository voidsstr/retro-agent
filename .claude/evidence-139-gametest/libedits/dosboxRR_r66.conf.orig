[IPX]
ipx=true

[autoexec]
# Redneck Rampage: Suckin' Grits on Route 66 - one game, started directly.
# The collection menu in dosboxRR_single.conf waits for a keypress, which on a
# fleet box means the game never starts because nobody is at the keyboard. Each
# game therefore also gets a conf of its own and a shortcut of its own, which is
# the "ONE SHORTCUT PER LINE" rule in CLAUDE.md applied to a compilation.
# The menu launcher is still there for anyone sitting in front of the machine.
@echo off
cls
mount C ".."
imgmount d "..\Redneck.inst" -t iso -fs iso
c:
fix.exe
cls
ROUTE66M.EXE
EXIT

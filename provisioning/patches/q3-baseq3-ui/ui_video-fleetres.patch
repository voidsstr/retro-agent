 /*
 =================
+GraphicsOptions_BuildModeList
+
+FLEETRES: build the Video Mode list and find the entry the game is running
+in - see ui_fleetres.h.  Must run before the spin control is added.
+=================
+*/
+static void GraphicsOptions_BuildModeList( void )
+{
+	char	modes[FR_MODES_LEN];
+
+	// ioquake3 publishes the modes the driver enumerated; retail 1.32c does not
+	trap_Cvar_VariableStringBuffer( "r_availableModes", modes, sizeof( modes ) );
+	FR_Build( &s_fr, modes );
+	FR_Select( &s_fr, (int)trap_Cvar_VariableValue( "r_mode" ),
+		(int)trap_Cvar_VariableValue( "r_customwidth" ),
+		(int)trap_Cvar_VariableValue( "r_customheight" ),
+		uis.glconfig.vidWidth, uis.glconfig.vidHeight );
+}
+

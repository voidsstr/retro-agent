# C build output
*.o
*.obj
*.map
agent/obj/
agent-linux/obj/

# Agent binaries
agent/retro_agent.exe
agent-linux/retro_agent_linux

# Python
__pycache__/
*.pyc
.venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.dbtests/.obj/

# vendored vintage H5 source (authoritative copy in retro-3dfx; reproduce via its README)
voodoo-cleanroom/vcr-disp-h5/src/

# Local-only symlink to the private repo's game-servers skill (server creds
# live there; the chat brain discovers skills from this repo's .claude/skills)
.claude/skills/game-servers

# gamebots: third-party engine source clones and build output (never committed)
# -- covers scripts/gamebots/adapters/goldsrc/build/ (ValveSoftware/halflife +
# alliedmodders/metamod-hl1, cloned by its Makefile's `deps` target) and any
# sibling engine adapter's build/out dir.
scripts/gamebots/adapters/*/build/
scripts/gamebots/adapters/*/out/

# Stray repo-root `build` SYMLINK left behind by an agent worktree run; it points
# at .claude/worktrees/<id>/scripts/gamebots/adapters/goldsrc/build, i.e. the two
# upstream clones (hlsdk, metamod-hl1) plus retrobot.so. No trailing slash -- the
# adapters/*/build/ rule above cannot catch it because a symlink is not a dir.
/build

# hand-made config backups (e.g. scripts/pxe/pxe_config.json.bak)
*.bak
